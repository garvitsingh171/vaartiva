{
  "name": "vaartiva",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14",
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "design/tokens"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run typecheck"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.11.8"
  }
}
